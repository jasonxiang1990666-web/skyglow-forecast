.detail-page { min-height: 100vh; padding: 34rpx 28rpx 56rpx; box-sizing: border-box; }
.detail-header { margin: 8rpx 4rpx 28rpx; }
.detail-city { color: #26384b; font-size: 42rpx; font-weight: 600; }
.detail-period { margin-top: 10rpx; color: #7b8794; font-size: 24rpx; }
.share-button { display: inline-flex; align-items: center; justify-content: center; height: 58rpx; margin: 18rpx 0 0; padding: 0 22rpx; border: 1rpx solid #d8e0e8; border-radius: 999rpx; background: #fff; color: #47799f; font-size: 22rpx; line-height: 1; }
.share-button::after { border: 0; }
.countdown-card { padding: 30rpx; background: linear-gradient(135deg, #fff3e2, #fde8d5); }
.countdown-active { background: linear-gradient(135deg, #fff0dd, #f9dfcd); }
.countdown-title { color: #7c4a2b; font-size: 26rpx; }
.countdown-value { margin-top: 10rpx; color: #9a4e20; font-size: 54rpx; font-weight: 600; line-height: 1.2; }
.countdown-detail { margin-top: 12rpx; color: #7b8794; font-size: 23rpx; }
.warning-card { margin-top: 24rpx; padding: 28rpx; border-radius: 28rpx; background: #fff1f0; color: #a53b36; }
.warning-title { font-size: 29rpx; font-weight: 600; }
.warning-detail { margin-top: 10rpx; font-size: 23rpx; line-height: 1.7; }
.detail-sky-card { margin-top: 24rpx; overflow: hidden; }
.summary-card { display: flex; justify-content: space-between; min-height: 210rpx; padding: 30rpx; background: #f8f4ec; }
.summary-low { background: #f1f5f9; }
.summary-high { background: linear-gradient(135deg, #fff3e2, #fee8d5 58%, #e9eefb); }
.summary-type { color: #475569; font-size: 28rpx; }
.summary-score { display: flex; align-items: baseline; gap: 8rpx; margin-top: 8rpx; color: #9a4e20; font-size: 74rpx; font-weight: 600; line-height: 1; }
.summary-score-label { color: #7b5a42; font-size: 22rpx; font-weight: 400; }
.summary-score-unit { font-size: 30rpx; }
.summary-low .summary-score, .summary-low .summary-label { color: #64748b; }
.summary-label { margin-top: 14rpx; color: #7c3f1d; font-size: 28rpx; font-weight: 600; }
.summary-right { max-width: 270rpx; color: #5d6470; font-size: 23rpx; line-height: 1.7; text-align: right; }
.summary-reason { margin-top: 12rpx; }
.direction { margin-top: 10rpx; color: #9a4e20; font-weight: 600; }
.detail-fire-row { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: 26rpx 30rpx; border-top: 1rpx solid #edf0f3; }
.detail-fire-direction { font-size: 22rpx; }
.sky-name { color: #293548; font-size: 28rpx; font-weight: 600; }
.sky-label { margin-left: 10rpx; font-size: 21rpx; font-weight: 400; }
.sky-high { color: #b45309; }
.sky-medium { color: #8a6a3f; }
.sky-low { color: #7b8794; }
.sky-reason { margin-top: 10rpx; color: #7b8794; font-size: 22rpx; line-height: 1.5; }
.sky-score { margin-left: 18rpx; color: #475569; font-size: 36rpx; font-weight: 600; }
.detail-fire-row .sky-score { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; font-size: 25rpx; }
.sky-probability { color: #718096; font-size: 21rpx; font-weight: 400; }
.probability-note { margin: 14rpx 6rpx 0; color: #7b8794; font-size: 21rpx; line-height: 1.6; }
.section-title { margin: 36rpx 4rpx 16rpx; color: #334155; font-size: 30rpx; font-weight: 600; }
.advice-card { padding: 28rpx 30rpx; color: #536273; font-size: 25rpx; line-height: 1.7; }
.rain-impact { margin: 12rpx 8rpx 0; color: #a65d27; font-size: 23rpx; line-height: 1.6; }
.featured-heading { display: flex; align-items: baseline; justify-content: space-between; }
.featured-heading .section-title { margin-bottom: 16rpx; }
.featured-more { margin-right: 4rpx; color: #47799f; font-size: 22rpx; }
.featured-card { overflow: hidden; }
.featured-state { padding: 30rpx; color: #718096; font-size: 23rpx; line-height: 1.6; }
.featured-row { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; }
.featured-row + .featured-row { border-top: 1rpx solid #edf0f3; }
.featured-main { min-width: 0; flex: 1; }
.featured-name { display: flex; align-items: center; color: #334155; font-size: 27rpx; font-weight: 600; }
.featured-badge { flex: none; margin-right: 10rpx; padding: 4rpx 10rpx; border-radius: 8rpx; background: #e6f2eb; color: #4f7d63; font-size: 19rpx; font-weight: 400; }
.featured-tags, .featured-address { margin-top: 9rpx; color: #718096; font-size: 21rpx; line-height: 1.5; }
.featured-side { display: flex; flex: 0 0 70rpx; flex-direction: column; align-items: flex-end; margin-left: 16rpx; color: #8b98a8; font-size: 20rpx; }
.featured-link { margin-top: 10rpx; color: #47799f; font-size: 22rpx; }
.nearby-card { overflow: hidden; }
.nearby-intro, .nearby-empty { padding: 28rpx 30rpx; }
.nearby-title { color: #334155; font-size: 27rpx; font-weight: 600; }
.nearby-description { margin-top: 10rpx; color: #718096; font-size: 23rpx; line-height: 1.55; }
.nearby-button { display: inline-flex; align-items: center; justify-content: center; min-height: 60rpx; margin-top: 22rpx; padding: 0 24rpx; border-radius: 999rpx; background: #eaf3f9; color: #356b94; font-size: 23rpx; font-weight: 600; }
.nearby-button-secondary { margin-top: 16rpx; }
.nearby-loading { padding: 36rpx 30rpx; color: #7b8794; font-size: 24rpx; text-align: center; }
.spot-row { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; cursor: pointer; }
.spot-row + .spot-row { border-top: 1rpx solid #edf0f3; }
.spot-main { min-width: 0; flex: 1; }
.spot-name { color: #334155; font-size: 27rpx; font-weight: 600; }
.spot-address, .spot-reason { margin-top: 8rpx; color: #7b8794; font-size: 21rpx; line-height: 1.5; }
.spot-reason { color: #64748b; }
.spot-side { display: flex; flex: 0 0 110rpx; flex-direction: column; align-items: flex-end; margin-left: 18rpx; color: #64748b; font-size: 22rpx; }
.spot-link { margin-top: 13rpx; color: #47799f; font-size: 22rpx; }
.nearby-note { padding: 0 30rpx 22rpx; color: #9aa5b1; font-size: 20rpx; line-height: 1.5; }
.air-card { padding: 26rpx 30rpx; }
.air-title { color: #334155; font-size: 27rpx; font-weight: 600; }
.air-level { margin-left: 10rpx; font-size: 23rpx; }
.air-good { color: #4f7d63; }
.air-medium { color: #a36c30; }
.air-poor { color: #b4534d; }
.air-description { margin-top: 10rpx; color: #66778a; font-size: 23rpx; }
.air-metrics { display: flex; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f3; }
.air-metric { display: flex; flex: 1; flex-direction: column; min-width: 0; color: #8b98a8; font-size: 20rpx; }
.air-metric + .air-metric { padding-left: 14rpx; border-left: 1rpx solid #edf0f3; }
.air-metric-value { margin-top: 8rpx; color: #475569; font-size: 24rpx; font-weight: 600; white-space: nowrap; }
.air-note { margin-top: 20rpx; color: #8b98a8; font-size: 20rpx; line-height: 1.55; }
.factor-card { overflow: hidden; }
.factor-group { padding: 26rpx 30rpx; }
.factor-group-last { border-top: 1rpx solid #edf0f3; }
.factor-heading { font-size: 25rpx; font-weight: 600; }
.factor-good { color: #4f7d63; }
.factor-bad { color: #a65d27; }
.factor-item { margin-top: 12rpx; color: #66778a; font-size: 23rpx; line-height: 1.55; }
.timeline-heading { display: flex; align-items: baseline; justify-content: space-between; }
.timeline-heading .section-title { margin-bottom: 16rpx; }
.timeline-note { color: #8b98a8; font-size: 21rpx; }
.timeline-card { overflow: hidden; }
.hourly-row { display: flex; align-items: center; min-height: 82rpx; padding: 0 24rpx; color: #66778a; font-size: 22rpx; }
.hourly-row + .hourly-row { border-top: 1rpx solid #edf0f3; }
.hourly-window { background: #fff7ed; color: #8c582c; }
.hour-time { width: 76rpx; color: #334155; font-weight: 600; }
.hour-weather { flex: 1; }
.hour-probability { width: 116rpx; text-align: right; }
.hour-cloud { width: 104rpx; text-align: right; }
.timeline-empty { padding: 28rpx; color: #7b8794; font-size: 24rpx; }
.updated-at { margin-top: 24rpx; color: #9aa5b1; font-size: 22rpx; text-align: center; }
.loading-page { padding-top: 36vh; color: #718096; font-size: 28rpx; text-align: center; }
.error-page { padding-top: 34vh; color: #718096; font-size: 27rpx; text-align: center; }
.retry-button { display: inline-block; margin-top: 28rpx; padding: 16rpx 34rpx; border-radius: 999rpx; background: #eaf3f9; color: #356b94; font-size: 25rpx; }
