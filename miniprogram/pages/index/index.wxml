<template name="rainCard">
  <view class="rain-card card {{rain.isSoon ? 'rain-urgent' : ''}}" bindtap="goRainDetail" role="button" aria-label="查看未来12小时降雨详情">
    <view class="rain-card-header">
      <text class="rain-card-title">降雨动态</text><text class="rain-card-link">未来12小时 ›</text>
    </view>
    <view class="rain-main">
      <view>
        <view class="rain-title">{{rain.headline}}</view>
        <view class="rain-detail">{{rain.detail}}</view>
      </view>
      <view class="rain-score">{{rain.probability}}%</view>
    </view>
    <view class="rain-meta"><text>{{rain.alertDriven ? '气象预警' : '降水概率'}}</text><text>{{rain.alertDriven ? '可能影响出行' : '累计 ' + rain.precipitationText}}</text></view>
    <view wx:if="{{!rain.alertDriven}}" class="rain-timeline">
      <view wx:for="{{rain.summaryTimeline}}" wx:key="timestamp" class="rain-time-node">
        <text class="rain-node-time">{{item.time}}</text>
        <view class="rain-node-dot {{item.isRaining ? 'rain-node-active' : ''}}"></view>
        <text class="rain-node-weather">{{item.isRaining ? '有雨' : item.weather}}</text>
      </view>
    </view>
  </view>
</template>

<view class="index-page" wx:if="{{!loading && forecast}}">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; padding-right: {{menuRightSpace}}px;">
    <view class="topbar" style="height: {{navContentHeight}}px;">
    <view class="city-picker" bindtap="goCities" role="button" aria-label="切换城市">
      <text class="city-name">{{city}}</text><text class="city-arrow">⌄</text>
    </view>
      <view class="settings-link" bindtap="goSettings" role="button" aria-label="提醒设置">设置</view>
      <button class="share-button" open-type="share" aria-label="分享霞况预报">分享</button>
    </view>
  </view>

  <view class="page-content">
    <view class="page-intro">
      <view class="page-eyebrow">霞况预报</view>
      <view class="page-subtitle">根据当前位置，看看今天与明天的天空</view>
    </view>
    <view class="forecast-status-line">
      <view class="status-dot"></view>
      <text class="status-label">当前位置预报</text>
      <text class="status-time">{{forecast.updatedAt}}</text>
    </view>
    <view wx:if="{{forecast.warning}}" class="warning-card">
      <view class="warning-title">安全提醒 · {{forecast.warning.title}}</view>
      <view class="warning-detail">{{forecast.warning.detail}}</view>
    </view>

    <view wx:if="{{forecast.shortRain && forecast.shortRain.isSoon}}" class="rain-section rain-priority">
      <template is="rainCard" data="{{rain: forecast.shortRain}}" />
    </view>

    <view class="sky-content">
      <view wx:if="{{forecast.allLow}}" class="outlook-quiet card">
        <view class="outlook-title">接下来24小时霞况不太明显</view>
        <view class="outlook-detail">云层和降雨会影响光照条件，不建议出门观霞</view>
      </view>

      <view class="window-heading">
        <view class="window-heading-main"><text class="window-kicker">{{forecast.primaryWindow.kind === 'sunrise' ? '晨间天空' : '傍晚天空'}}</text><text>{{forecast.primaryWindow.title}}</text></view><view class="window-heading-side" hover-class="window-link-hover" bindtap="goSkyDetail" data-window-index="0" role="button" aria-label="查看{{forecast.primaryWindow.title}}霞况详情"><text class="window-view-link">查看详情 ›</text><text class="window-time">{{forecast.primaryWindow.time}}</text></view>
      </view>
      <view class="sky-window-card card sky-window-primary" hover-class="sky-card-hover" bindtap="goSkyDetail" data-window-index="0" role="button" aria-label="查看{{forecast.primaryWindow.title}}霞况详情">
        <view class="hero hero-{{forecast.primaryWindow.primarySky.tier}}">
          <view>
            <view class="hero-topline"><view class="hero-type">{{forecast.primaryWindow.primarySky.type}}</view><text class="hero-chip">霞况模型</text></view>
            <view class="hero-score"><text class="hero-score-label">霞况评分</text><text class="hero-score-number">{{forecast.primaryWindow.primarySky.score}}</text><text class="hero-score-unit">分</text></view>
            <view class="hero-label">{{forecast.primaryWindow.primarySky.label}}</view>
            <view class="hero-probability">{{forecast.primaryWindow.primarySky.probabilityLabel || '模型估算出现概率'}} {{forecast.primaryWindow.primarySky.probability}}%</view>
          </view>
          <view class="hero-detail">
            <view>{{forecast.primaryWindow.primarySky.reason}}</view>
            <view wx:if="{{forecast.primaryWindow.primarySky.showDirection && !forecast.warning}}" class="direction">{{forecast.primaryWindow.primarySky.direction}}</view>
          </view>
        </view>
        <view class="sky-row sky-row-fire">
          <view>
            <view class="sky-name">{{forecast.primaryWindow.fireCloud.type}} <text class="sky-label fire-vividness-{{forecast.primaryWindow.fireCloud.vividnessLevel}}">{{forecast.primaryWindow.fireCloud.vividnessLabel || forecast.primaryWindow.fireCloud.label}}</text></view>
            <view class="sky-reason">{{forecast.primaryWindow.fireCloud.time}} · {{forecast.primaryWindow.fireCloud.vividnessReason || forecast.primaryWindow.fireCloud.reason}}</view>
          </view>
          <view class="sky-score"><text wx:if="{{forecast.primaryWindow.fireCloud.vividnessLabel}}">鲜艳度 {{forecast.primaryWindow.fireCloud.vividnessText}}</text><text wx:else>评分 {{forecast.primaryWindow.fireCloud.score}}分</text><text class="sky-probability">概率 {{forecast.primaryWindow.fireCloud.probability}}%</text></view>
        </view>
        <view class="confidence-strip confidence-{{confidenceView.tone}}">
          <text>{{confidenceView.label}}</text>
          <text>{{confidenceView.summary}}</text>
          <text>{{forecast.updatedAt}}</text>
        </view>
        <view class="sky-card-action">查看{{forecast.primaryWindow.title}}详情 <text>›</text></view>
      </view>
      <view wx:if="{{solarCountdown || forecast.airReference}}" class="atmosphere-reference card">
        <view wx:if="{{solarCountdown}}" class="reference-item">
          <text class="reference-value reference-value-leading">{{solarCountdown}}</text>
          <text wx:if="{{forecast.primaryWindow.solarTime}}" class="reference-note">{{forecast.primaryWindow.kind === 'sunrise' ? '日出' : '日落'}} {{forecast.primaryWindow.solarTime}}</text>
        </view>
        <view wx:if="{{solarCountdown && forecast.airReference}}" class="reference-divider"></view>
        <view wx:if="{{forecast.airReference}}" class="reference-item">
          <text class="reference-label">空气通透</text>
          <text class="reference-value air-{{forecast.airReference.level}}">{{forecast.airReference.label}}</text>
          <text class="reference-note">详情可查看 AQI 与 PM2.5</text>
        </view>
      </view>
      <view wx:if="{{forecast.primaryWindow.rainImpact}}" class="sky-rain-impact">{{forecast.primaryWindow.rainImpact}}</view>

      <view class="window-heading next-window-heading">
        <view class="window-heading-main"><view class="window-kicker">另一个观赏窗口</view><text>{{forecast.secondaryWindow.title}}</text></view><view class="window-heading-side" hover-class="window-link-hover" bindtap="goSkyDetail" data-window-index="1" role="button" aria-label="查看{{forecast.secondaryWindow.title}}霞况详情"><text class="window-view-link">查看详情 ›</text><text class="window-time">{{forecast.secondaryWindow.time}}</text></view>
      </view>
      <view class="sky-window-card card sky-window-secondary" hover-class="sky-card-hover" bindtap="goSkyDetail" data-window-index="1" role="button" aria-label="查看{{forecast.secondaryWindow.title}}霞况详情">
        <view class="sky-row sky-row-fire">
          <view>
            <view class="sky-name">{{forecast.secondaryWindow.primarySky.type}} <text class="sky-label sky-{{forecast.secondaryWindow.primarySky.tier}}">{{forecast.secondaryWindow.primarySky.label}}</text></view>
            <view class="sky-reason">{{forecast.secondaryWindow.primarySky.time}} · {{forecast.secondaryWindow.primarySky.reason}}</view>
            <view wx:if="{{forecast.secondaryWindow.primarySky.showDirection && !forecast.warning}}" class="direction sky-direction">{{forecast.secondaryWindow.primarySky.direction}}</view>
          </view>
          <view class="sky-score"><text>评分 {{forecast.secondaryWindow.primarySky.score}}分</text><text class="sky-probability">概率 {{forecast.secondaryWindow.primarySky.probability}}%</text></view>
        </view>
        <view class="sky-row">
          <view>
            <view class="sky-name">{{forecast.secondaryWindow.fireCloud.type}} <text class="sky-label fire-vividness-{{forecast.secondaryWindow.fireCloud.vividnessLevel}}">{{forecast.secondaryWindow.fireCloud.vividnessLabel || forecast.secondaryWindow.fireCloud.label}}</text></view>
            <view class="sky-reason">{{forecast.secondaryWindow.fireCloud.time}} · {{forecast.secondaryWindow.fireCloud.vividnessReason || forecast.secondaryWindow.fireCloud.reason}}</view>
          </view>
          <view class="sky-score"><text wx:if="{{forecast.secondaryWindow.fireCloud.vividnessLabel}}">鲜艳度 {{forecast.secondaryWindow.fireCloud.vividnessText}}</text><text wx:else>评分 {{forecast.secondaryWindow.fireCloud.score}}分</text><text class="sky-probability">概率 {{forecast.secondaryWindow.fireCloud.probability}}%</text></view>
        </view>
        <view class="sky-card-action">查看{{forecast.secondaryWindow.title}}详情 <text>›</text></view>
      </view>
      <view wx:if="{{forecast.secondaryWindow.rainImpact}}" class="sky-rain-impact">{{forecast.secondaryWindow.rainImpact}}</view>

      <view wx:if="{{forecast.shortRain && !forecast.shortRain.isSoon}}" class="rain-section">
        <template is="rainCard" data="{{rain: forecast.shortRain}}" />
      </view>
    </view>

    <view class="trend-heading" bindtap="goTwoWeekWeather" role="button" aria-label="查看未来两周天气">
      <text class="section-title">未来三天</text><text class="trend-link">查看两周预报 ›</text>
    </view>
    <view class="trend-list card" bindtap="goTwoWeekWeather" role="button" aria-label="查看未来两周天气">
      <view wx:for="{{forecast.trend}}" wx:key="day" class="trend-row">
        <text class="trend-day">{{item.day}}</text>
        <text class="trend-weather">{{item.weather}}</text>
        <text>{{item.temperature}}</text>
        <text class="trend-rain">降水 {{item.precipitation}}</text>
      </view>
    </view>
    <view class="updated-at">{{forecast.updatedAt}}</view>
  </view>
</view>

<view wx:else class="loading-page">正在获取当前位置与实时 EC/GFS 数据…</view>
