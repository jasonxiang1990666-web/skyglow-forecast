.topbar, .city-picker, .hero, .sky-row, .rain-row, .trend-row {
  display: flex;
  align-items: center;
}

.index-page { min-height: 100vh; }
.custom-nav { box-sizing: border-box; padding-left: 28rpx; }
.page-content { padding: 18rpx 28rpx 48rpx; }
.topbar {
  justify-content: space-between;
  box-sizing: border-box;
}

.city-picker { gap: 10rpx; }
.city-name { font-size: 40rpx; font-weight: 600; }
.city-arrow { color: #64748b; font-size: 34rpx; }
.settings-link { color: #52687a; font-size: 26rpx; }
.share-button { margin: 0 0 0 14rpx; padding: 0; border: 0; background: transparent; color: #47799f; font-size: 24rpx; line-height: 1.5; }
.share-button::after { border: 0; }
.date-line { color: #718096; font-size: 26rpx; }
.window-heading { display: flex; justify-content: space-between; margin: 26rpx 4rpx 16rpx; color: #334155; font-size: 30rpx; font-weight: 600; }
.window-time { color: #7b8794; font-size: 24rpx; font-weight: 400; }
.next-window-heading { margin-top: 36rpx; }

.hero {
  justify-content: space-between;
  min-height: 248rpx;
  margin-top: 18rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #fff3e2, #fee8d5 56%, #e9eefb);
}
.sky-window-card { overflow: hidden; cursor: pointer; }
.sky-card-hover { opacity: .92; transform: translateY(1rpx); }
.sky-window-card .hero { margin-top: 0; border-radius: 0; box-shadow: none; }
.atmosphere-reference { display: flex; align-items: stretch; margin-top: 14rpx; padding: 20rpx 24rpx; background: #f4f8fb; }
.reference-item { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.reference-item + .reference-item { padding-left: 24rpx; }
.reference-label { color: #7b8794; font-size: 21rpx; }
.reference-value { margin-top: 6rpx; color: #334155; font-size: 26rpx; font-weight: 600; }
.reference-value-leading { margin-top: 0; }
.reference-note { margin-top: 6rpx; color: #8b98a8; font-size: 20rpx; }
.reference-divider { width: 1rpx; margin: 4rpx 0; background: #dce7ee; }
.air-good { color: #4f7d63; }
.air-medium { color: #a36c30; }
.air-poor { color: #b4534d; }

.hero-low { background: #f1f5f9; }
.hero-medium { background: linear-gradient(135deg, #f8f4ec, #f6efe4); }
.hero-type { color: #475569; font-size: 30rpx; }
.hero-score { display: flex; align-items: baseline; gap: 8rpx; margin-top: 8rpx; color: #9a4e20; font-size: 84rpx; font-weight: 600; line-height: 1; }
.hero-score-label { color: #7b5a42; font-size: 22rpx; font-weight: 400; }
.hero-score-unit { font-size: 32rpx; }
.hero-low .hero-score { color: #64748b; }
.hero-label { margin-top: 16rpx; color: #7c3f1d; font-size: 30rpx; font-weight: 600; }
.hero-low .hero-label { color: #64748b; }
.hero-probability { margin-top: 10rpx; color: #8b725e; font-size: 21rpx; }
.hero-low .hero-probability { color: #7b8794; }
.hero-detail { max-width: 248rpx; color: #5d6470; font-size: 24rpx; line-height: 1.8; text-align: right; }
.direction { margin-top: 12rpx; color: #9a4e20; font-weight: 600; }
.sky-direction { font-size: 22rpx; }
.outlook-quiet { margin-top: 18rpx; padding: 28rpx 30rpx; background: #f1f5f9; }
.outlook-title { color: #475569; font-size: 30rpx; font-weight: 600; }
.outlook-detail { margin-top: 10rpx; color: #7b8794; font-size: 24rpx; }

.sky-list, .trend-list { overflow: hidden; }
.sky-row, .rain-row { justify-content: space-between; padding: 28rpx 30rpx; }
.sky-row + .sky-row, .trend-row + .trend-row { border-top: 1rpx solid #edf0f3; }
.sky-name, .rain-title { color: #293548; font-size: 30rpx; font-weight: 600; }
.sky-label { margin-left: 10rpx; font-size: 22rpx; font-weight: 400; }
.sky-high { color: #b45309; }
.sky-medium { color: #8a6a3f; }
.sky-low { color: #7b8794; }
.fire-vividness-large { color: #b45309; }
.fire-vividness-medium { color: #c27632; }
.fire-vividness-small { color: #8a6a3f; }
.fire-vividness-none { color: #7b8794; }
.sky-reason, .rain-detail { margin-top: 10rpx; color: #7b8794; font-size: 24rpx; }
.sky-score, .rain-score { color: #475569; font-size: 36rpx; font-weight: 600; }
.sky-score { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; font-size: 25rpx; }
.sky-probability { color: #718096; font-size: 21rpx; font-weight: 400; }
.rain-active { background: #f2f7fb; }
.rain-active .rain-score { color: #356b94; }
.rain-section { margin-top: 30rpx; }
.rain-priority { margin-top: 22rpx; }
.rain-card { padding: 26rpx 28rpx 24rpx; background: #f2f7fb; }
.rain-urgent { background: linear-gradient(135deg, #edf7ff, #f0f7fb); }
.rain-card-header, .rain-main, .rain-meta, .rain-timeline { display: flex; }
.rain-card-header { justify-content: space-between; align-items: center; }
.rain-card-title { color: #334155; font-size: 30rpx; font-weight: 600; }
.rain-card-link { color: #5680a2; font-size: 23rpx; }
.rain-main { align-items: center; justify-content: space-between; margin-top: 18rpx; }
.rain-main .rain-title { color: #294661; font-size: 32rpx; }
.rain-main .rain-score { color: #356b94; }
.rain-meta { justify-content: space-between; margin-top: 14rpx; color: #718096; font-size: 22rpx; }
.rain-timeline { justify-content: space-between; margin-top: 22rpx; }
.rain-time-node { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; }
.rain-node-time, .rain-node-weather { color: #7b8794; font-size: 20rpx; white-space: nowrap; }
.rain-node-dot { width: 12rpx; height: 12rpx; margin: 12rpx 0 10rpx; border-radius: 50%; background: #cbd5e1; }
.rain-node-active { width: 16rpx; height: 16rpx; margin: 10rpx 0 8rpx; background: #4d8db8; box-shadow: 0 0 0 5rpx #d9edf8; }
.sky-rain-impact { margin: 12rpx 8rpx 0; color: #a65d27; font-size: 23rpx; line-height: 1.6; }

.trend-heading { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 4rpx 20rpx; cursor: pointer; }
.trend-heading .section-title { margin: 0; }
.trend-link { color: #5680a2; font-size: 23rpx; }
.trend-list { cursor: pointer; }
.trend-row { min-height: 88rpx; padding: 0 26rpx; color: #536273; font-size: 24rpx; }
.trend-day { width: 86rpx; color: #334155; font-weight: 600; }
.trend-weather { width: 104rpx; }
.trend-rain { margin-left: auto; color: #7b8794; }
.national-overview-heading { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 4rpx 18rpx; color: #334155; font-size: 30rpx; font-weight: 600; }
.national-overview-heading text:last-child { color: #7b8794; font-size: 21rpx; font-weight: 400; }
.national-overview-card { overflow: hidden; padding: 22rpx 24rpx; cursor: pointer; }
.national-overview-map { position: relative; height: 250rpx; overflow: hidden; border-radius: 20rpx; background: linear-gradient(150deg, #edf3f7, #fafcfd); }
.national-overview-map::before { position: absolute; top: 34rpx; right: 64rpx; bottom: 38rpx; left: 62rpx; border: 2rpx solid #d4e0e8; border-radius: 48% 42% 50% 38%; content: ''; transform: rotate(-4deg); }
.national-overview-map::after { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-image: linear-gradient(#dce5ec 1rpx, transparent 1rpx), linear-gradient(90deg, #dce5ec 1rpx, transparent 1rpx); background-size: 42rpx 42rpx; content: ''; opacity: .34; }
.national-overview-point { position: absolute; z-index: 1; width: 17rpx; height: 17rpx; margin: -9rpx 0 0 -9rpx; border: 3rpx solid rgba(255, 255, 255, .82); border-radius: 50%; box-sizing: border-box; box-shadow: 0 2rpx 6rpx rgba(60, 75, 90, .18); }
.national-overview-water { position: absolute; z-index: 1; right: 18rpx; bottom: 12rpx; color: #8fa4b6; font-size: 19rpx; font-weight: 600; letter-spacing: 3rpx; }
.national-overview-footer { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; color: #718096; font-size: 20rpx; white-space: nowrap; }
.national-overview-legend { display: flex; align-items: center; }
.national-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 5rpx; border-radius: 50%; }
.national-high { background: #c77a3a; }
.national-medium { background: #d6aa59; }
.national-low { background: #aab9c7; }
.national-overview-link { margin-left: auto; color: #47799f; }
.national-overview-note { margin-top: 14rpx; color: #8b98a8; font-size: 20rpx; line-height: 1.5; }
.national-overview-loading { margin: 16rpx 4rpx 0; color: #8b98a8; font-size: 22rpx; }

/* 全国城市概览改为独立页面，不在首页占用首屏和滚动空间。 */
.national-overview-heading,
.national-overview-card,
.national-overview-loading { display: none; }
.updated-at { margin-top: 22rpx; color: #9aa5b1; font-size: 22rpx; text-align: center; }
.warning-card { margin-top: 42rpx; padding: 30rpx; border-radius: 28rpx; background: #fff1f0; color: #a53b36; }
.warning-title { font-size: 32rpx; font-weight: 600; }
.warning-detail { margin-top: 12rpx; font-size: 25rpx; line-height: 1.7; }
.loading-page { padding-top: 36vh; color: #718096; font-size: 28rpx; text-align: center; }

