/* 浅色科技感增强：用数据状态、微光和网格纹理表达“观测站”气质。 */
.index-page {
  background:
    radial-gradient(circle at 90% 7%, rgba(127, 211, 230, .13), transparent 29%),
    radial-gradient(circle at 5% 42%, rgba(255, 185, 125, .09), transparent 26%),
    linear-gradient(180deg, #f8fbfd 0%, #f2f7fa 58%, #f7fafc 100%);
}
.page-intro { position: relative; }
.page-intro::after {
  position: absolute;
  top: -8rpx;
  right: 0;
  width: 96rpx;
  height: 58rpx;
  border-top: 1rpx solid rgba(91, 166, 192, .34);
  border-right: 1rpx solid rgba(91, 166, 192, .18);
  border-radius: 0 30rpx 0 0;
  content: '';
  opacity: .9;
}
.page-eyebrow { color: #3e6d82; font-size: 23rpx; font-weight: 600; letter-spacing: 5rpx; }
.forecast-status-line { display: flex; align-items: center; min-height: 42rpx; margin: 4rpx 4rpx 16rpx; padding: 0 14rpx; border: 1rpx solid #d9e8ef; border-radius: 999rpx; background: rgba(239, 248, 251, .86); color: #638090; font-size: 19rpx; }
.status-dot { width: 10rpx; height: 10rpx; margin-right: 8rpx; border-radius: 50%; background: #46b5a0; box-shadow: 0 0 0 5rpx rgba(70, 181, 160, .13); }
.status-label { color: #43728a; font-weight: 600; }
.status-time { margin-left: auto; color: #8aa0ac; }
.hero { position: relative; overflow: hidden; }
.hero::before {
  position: absolute;
  top: -90rpx;
  right: -42rpx;
  width: 230rpx;
  height: 230rpx;
  border: 1rpx solid rgba(255, 255, 255, .62);
  border-radius: 50%;
  box-shadow: 0 0 0 20rpx rgba(255, 255, 255, .14), 0 0 0 42rpx rgba(255, 255, 255, .08);
  content: '';
}
.hero::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 84rpx;
  background-image: linear-gradient(rgba(255, 255, 255, .2) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(255, 255, 255, .2) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
  content: '';
  opacity: .32;
  pointer-events: none;
}
.hero > view { position: relative; z-index: 1; }
.hero-topline { display: flex; align-items: center; gap: 12rpx; }
.hero-chip { padding: 5rpx 10rpx; border: 1rpx solid rgba(157, 112, 73, .22); border-radius: 999rpx; background: rgba(255, 255, 255, .36); color: #9a7355; font-size: 18rpx; }
.hero-score-number { text-shadow: 0 4rpx 16rpx rgba(156, 74, 29, .13); }
.sky-window-primary { border-color: rgba(230, 177, 128, .65); box-shadow: 0 12rpx 30rpx rgba(172, 104, 57, .08), 0 0 0 1rpx rgba(255, 255, 255, .55) inset; }
.sky-window-secondary { border-color: rgba(194, 214, 225, .88); box-shadow: 0 10rpx 26rpx rgba(66, 112, 139, .055); }
.sky-window-secondary .sky-row { background: rgba(246, 250, 252, .82); }
.confidence-strip { display: flex; align-items: center; gap: 10rpx; min-height: 48rpx; padding: 0 24rpx; background: #f4f7f8; color: #657986; font-size: 19rpx; }
.confidence-strip text:first-child { font-weight: 600; }
.confidence-strip text:last-child { margin-left: auto; color: #8c9aa4; font-size: 18rpx; }
.confidence-high { background: #eef8f2; color: #4f7d63; }
.confidence-medium { background: #faf6ed; color: #98713a; }
.confidence-low { background: #faf0ef; color: #a55c55; }
.confidence-pending { background: #f3f6f8; color: #71808b; }
.sky-card-action { display: flex; align-items: center; justify-content: center; min-height: 54rpx; border-top: 1rpx solid rgba(220, 229, 235, .72); color: #4a7895; font-size: 21rpx; letter-spacing: .5rpx; }
.sky-card-action text { margin-left: 5rpx; font-size: 28rpx; line-height: 1; }
.atmosphere-reference { position: relative; overflow: hidden; }
.atmosphere-reference::after { position: absolute; right: 18rpx; bottom: 12rpx; width: 68rpx; height: 36rpx; border-right: 1rpx solid rgba(75, 147, 174, .24); border-bottom: 1rpx solid rgba(75, 147, 174, .24); content: ''; opacity: .7; }
.reference-label { color: #7b94a1; letter-spacing: 1rpx; }
.reference-value { text-shadow: 0 2rpx 10rpx rgba(58, 126, 103, .1); }
.rain-card { position: relative; overflow: hidden; }
.rain-card::after { position: absolute; right: -18rpx; bottom: -42rpx; width: 150rpx; height: 150rpx; border: 1rpx solid rgba(89, 160, 194, .24); border-radius: 50%; box-shadow: 0 0 0 18rpx rgba(89, 160, 194, .06), 0 0 0 36rpx rgba(89, 160, 194, .04); content: ''; }
.rain-card > view { position: relative; z-index: 1; }
.trend-heading .section-title { display: flex; align-items: center; }
.trend-heading .section-title::before { width: 7rpx; height: 25rpx; margin-right: 10rpx; border-radius: 4rpx; background: #55a4bd; content: ''; }
.trend-list { background: rgba(255, 255, 255, .9); }
