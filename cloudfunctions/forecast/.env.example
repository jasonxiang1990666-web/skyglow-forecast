# 在微信云开发的云函数环境变量中配置，勿提交真实值。
QWEATHER_API_HOST=https://your-api-host.qweatherapi.com
QWEATHER_CREDENTIAL_ID=your-jwt-credential-id
QWEATHER_PROJECT_ID=your-project-id
# 将 PEM 私钥中的换行写作 \n，例如 -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
QWEATHER_PRIVATE_KEY=your-ed25519-private-key

# 腾讯位置服务 WebService API Key：用于检索附近公园、观景点等公开 POI。
# 请仅配置在云函数环境变量中，不要写入小程序代码或提交到 Git。
TENCENT_MAP_KEY=your-tencent-map-webservice-key
